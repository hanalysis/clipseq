nextflow_pipeline {
    name "only_crosslinking"
    script "main.nf"

    test("only_crosslinking_primary") {
        tag "only_crosslinking_primary"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_crosslinks = true
            }
        }

        then {
            assert workflow.success

            assert new File("$outputDir/04_crosslinks/PHO92_A.genome.cmd.bed").exists()
            assert new File("$outputDir/04_crosslinks/PHO92_A.genome.cmd.bedgraph").exists()
            assert new File("$outputDir/04_crosslinks/PHO92_A.norm.genome.cmd.bedgraph").exists()

            assert new File("$outputDir/04_crosslinks/PHO92_A.transcript.cmd.bed").exists()
            assert new File("$outputDir/04_crosslinks/PHO92_A.transcript.cmd.bedgraph").exists()
            assert new File("$outputDir/04_crosslinks/PHO92_A.norm.transcript.cmd.bedgraph").exists()

            assert new File("$outputDir/04_crosslinks/icountmini_summaries/PHO92_A.summary_gene.tsv").exists()
            assert new File("$outputDir/04_crosslinks/icountmini_summaries/PHO92_A.summary_subtype.tsv").exists()
            assert new File("$outputDir/04_crosslinks/icountmini_summaries/PHO92_A.summary_type.tsv").exists()
        }
    }
}
