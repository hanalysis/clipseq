nextflow_pipeline {
    name "only_alignment"
    script "main.nf"

    test("only_alignment_primary") {
        tag "only_alignment_primary"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                only_alignment = true
            }
        }

        then {
            assert workflow.success

            // NCRNA
            assert new File("$outputDir/02_alignment/ncrna/PHO92_A_ncrna.sorted.bam").exists()
            assert new File("$outputDir/02_alignment/ncrna/PHO92_A_ncrna.sorted.bam.bai").exists()
            assert new File("$outputDir/02_alignment/ncrna/unmapped/PHO92_A_ncrna.unmapped.fastq.gz").exists()

            // GENOME
            assert new File("$outputDir/02_alignment/genome/PHO92_A_multiMapped.Aligned.sortedByCoord.out.bam").exists()
            assert new File("$outputDir/02_alignment/genome/PHO92_A_multiMapped.Aligned.sortedByCoord.out.bam.bai").exists()
            assert new File("$outputDir/02_alignment/genome/PHO92_A_uniqueMapped.bam").exists()
            assert new File("$outputDir/02_alignment/genome/PHO92_A_uniqueMapped.bam.bai").exists()
        }
    }

    test("only_alignment_false_outputs") {
        tag "only_alignment_false_outputs"
        tag "test"
        when {
            params {
                outdir = "$outputDir"
                save_unaligned_output = false
                save_align_intermed = false
            }
        }

        then {
            assert workflow.success

            // NCRNA
            assert !(new File("$outputDir/02_alignment/ncrna/PHO92_A_ncrna.sorted.bam").exists())
            assert !(new File("$outputDir/02_alignment/ncrna/PHO92_A_ncrna.sorted.bam.bai").exists())
            assert !(new File("$outputDir/02_alignment/ncrna/unmapped/PHO92_A_ncrna.unmapped.fastq.gz").exists())

            // GENOME
            assert !(new File("$outputDir/02_alignment/genome/PHO92_A_multiMapped.Aligned.sortedByCoord.out.bam").exists())
            assert !(new File("$outputDir/02_alignment/genome/PHO92_A_multiMapped.Aligned.sortedByCoord.out.bam.bai").exists())
            assert !(new File("$outputDir/02_alignment/genome/PHO92_A_uniqueMapped.bam").exists())
            assert !(new File("$outputDir/02_alignment/genome/PHO92_A_uniqueMapped.bam.bai").exists())
        }
    }
}
